# Path to the directory that contains frappe-bench and this repo's runtime state.
PROJECT_ROOT=/opt/erpnext-dragonfly

# Path to an existing Frappe/ERPNext bench.
BENCH_DIR=/opt/frappe/frappe-bench

# ERPNext site name used by bench commands.
SITE_NAME=erpnext.localhost

# Bench HTTP endpoint used by health checks.
ERP_URL=http://erpnext.localhost:8000

# Dragonfly ports.
DFLY_CACHE_PORT=13400
DFLY_QUEUE_PORT=13401
DFLY_SOCKETIO_PORT=13402

# Dragonfly memory limits.
DFLY_CACHE_MAXMEMORY=512mb
DFLY_QUEUE_MAXMEMORY=768mb
DFLY_SOCKETIO_MAXMEMORY=512mb

# Optional PATH prefix for bench/node/yarn binaries.
EXTRA_PATH=
